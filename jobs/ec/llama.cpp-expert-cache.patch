+#include "llama-expert-cache.h"
+
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <chrono>
+#if defined(__linux__)
+#include <pthread.h>
+#include <sched.h>
+#endif
+
+#if defined(__x86_64__) || defined(_M_X64)
+#include <immintrin.h>
+static inline void cpu_relax() { _mm_pause(); }
+#else
+static inline void cpu_relax() {}
+#endif
+
+static int env_int(const char * name, int def) {
+    const char * v = getenv(name);
+    return v ? atoi(v) : def;
+}
+
+static double env_double(const char * name, double def) {
+    const char * v = getenv(name);
+    return v ? atof(v) : def;
+}
+
+// bytes of one expert in a per-expert tensor: [ne0, ne1, E] weights or [ne0, E] biases.
+// The expert dimension is decided by the source tensor (a slot tensor with one slot has a trailing 1).
+static int expert_dim(const ggml_tensor * src) {
+    return ggml_n_dims(src) >= 3 ? 2 : 1;
+}
+
+static size_t expert_stride(const ggml_tensor * src) {
+    return src->nb[expert_dim(src)];
+}
+
+llama_expert_cache::llama_expert_cache(const llama_model & model, ggml_backend_t gpu_backend, ggml_backend_dev_t gpu_dev) {
+    n_slots = env_int("LLAMA_EC_SLOTS", 0);
+    if (n_slots <= 0) {
+        n_slots = 0;
+        return;
+    }
+    const char * pol = getenv("LLAMA_EC_POLICY");
+    std::string p = pol ? pol : "dfa";
+    policy    = p == "static" ? STATIC : p == "lru" ? LRU : DFA;
+    half_life = env_double("LLAMA_EC_HALF_LIFE", 16.0);
+    kappa     = env_double("LLAMA_EC_KAPPA", 0.0);
+    overlap_cpu = env_int("LLAMA_EC_OVERLAP", 1) != 0;
+    check_ids   = env_int("LLAMA_EC_CHECK", 0) != 0;
+    max_admit   = env_int("LLAMA_EC_MAX_ADMIT", 0);
+    chunk       = (size_t) env_double("LLAMA_EC_CHUNK", 0.0);
+    paced       = env_int("LLAMA_EC_PACED", 0) != 0;
+    max_pending = env_int("LLAMA_EC_MAX_PENDING", 0);
+    if (paced && chunk == 0) {
+        chunk = 1u << 20;
+    }
+    if (const char * s = getenv("LLAMA_EC_STATS")) {
+        stats_path = s;
+    }
+    mailbox   = env_int("LLAMA_EC_MAILBOX", 0) != 0;
+    n_helpers = env_int("LLAMA_EC_HELPERS", std::max(1, (int) std::thread::hardware_concurrency() - 2));
+    pin_helpers = env_int("LLAMA_EC_PIN", 0) != 0;
+
+    const auto & hp = model.hparams;
+
+    for (int il = 0; il < (int) model.layers.size(); ++il) {
+        const auto & ly = model.layers[il];
+        if (ly.ffn_up_exps_s || ly.ffn_gate_exps_s || ly.ffn_down_exps_s) {
+            continue; // scaled experts are not supported
+        }
+        std::vector<ggml_tensor *> src;
+        for (ggml_tensor * t : { ly.ffn_gate_exps, ly.ffn_up_exps, ly.ffn_down_exps, ly.ffn_gate_up_exps,
+                                 ly.ffn_gate_exps_b, ly.ffn_up_exps_b, ly.ffn_down_exps_b, ly.ffn_gate_up_exps_b }) {
+            if (t) {
+                src.push_back(t);
+            }
+        }
+        if (src.empty() || !ly.ffn_down_exps) {
+            continue;
+        }
+        bool host = true;
+        for (auto * t : src) {
+            host = host && t->buffer && ggml_backend_buffer_is_host(t->buffer) && ggml_is_contiguous(t);
+        }
+        if (!host) {
+            continue; // experts of this layer already live on a device: nothing to cache
+        }
+        layer L;
+        L.il       = il;
+        L.n_expert = (int) hp.n_expert;
+        L.n_used   = (int) hp.n_expert_used(il);
+        L.src      = src;
+        if (!ly.ffn_gate_up_exps && ly.ffn_gate_exps && ly.ffn_up_exps) {
+            L.w_gate = ly.ffn_gate_exps;   L.w_up = ly.ffn_up_exps;   L.w_down = ly.ffn_down_exps;
+            L.b_gate = ly.ffn_gate_exps_b; L.b_up = ly.ffn_up_exps_b; L.b_down = ly.ffn_down_exps_b;
+        }
+        idx_of[il] = (int) layers.size();
+        layers.push_back(std::move(L));
+        max_used = std::max(max_used, (int) hp.n_expert_used(il));
+    }
+    if (layers.empty()) {
+        LLAMA_LOG_WARN("%s: LLAMA_EC_SLOTS set, but no MoE layer has its experts in host memory; cache disabled\n", __func__);
+        n_slots = 0;
+        return;
+    }
+
+    size_t n_tensors = 1;
+    for (auto & L : layers) {
+        n_tensors += L.src.size();
+        L.C = std::min(n_slots, L.n_expert);
+    }
+    if (const char * af = getenv("LLAMA_EC_ALLOC")) {
+        std::ifstream f(af);
+        int il, c;
+        while (f >> il >> c) {
+            if (idx_of.count(il)) {
+                layer & L = layers[idx_of[il]];
+                L.C = std::max(0, std::min(c, L.n_expert));
+            }
+        }
+    }
+    ggml_init_params ip = { ggml_tensor_overhead() * (n_tensors + 2), nullptr, true };
+    ctx = ggml_init(ip);
+
+    for (auto & L : layers) {
+        for (auto * t : L.src) {
+            ggml_tensor * s = expert_dim(t) == 2
+                ? ggml_new_tensor_3d(ctx, t->type, t->ne[0], t->ne[1], std::max(1, L.C))
+                : ggml_new_tensor_2d(ctx, t->type, t->ne[0], std::max(1, L.C));
+            ggml_format_name(s, "ec_slot.%s", t->name);
+            GGML_ASSERT(s->nb[expert_dim(t)] == expert_stride(t));
+            L.slot.push_back(s);
+        }
+        const int E = L.n_expert;
+        L.slot_of.assign(E, -1);
+        L.cpu_of.resize(E);
+        for (int e = 0; e < E; ++e) {
+            L.cpu_of[e] = e;
+        }
+        L.resident.assign(L.C, -1);
+        L.loading.assign(L.C, -1);
+        L.load_batch.assign(L.C, 0);
+        L.score.assign(E, 0.0);
+        L.last.assign(E, 0);
+        L.stamp.assign(E, -1);
+        L.count.assign(E, 0);
+        L.miss_hist.assign(L.n_used + 1, 0);
+    }
+    mb_busy_us.assign(max_used + 1, 0.0);
+    mb_count.assign(max_used + 1, 0);
+    routing = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, max_used, 3 * (int64_t) layers.size());
+    ggml_set_name(routing, "ec_routing");
+    routing_host.assign(3 * max_used * layers.size(), -1);
+    ctl = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 64);
+    ggml_set_name(ctl, "ec_ctl");
+
+    ggml_backend_buffer_type_t buft = gpu_dev ? ggml_backend_dev_buffer_type(gpu_dev)
+                                              : ggml_backend_get_default_buffer_type(gpu_backend);
+    buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+    GGML_ASSERT(buf && "expert cache: failed to allocate slot memory");
+    ggml_backend_buffer_clear(buf, 0);
+
+    if (gpu_dev && ggml_backend_dev_type(gpu_dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+        copy_backend = ggml_backend_dev_init(gpu_dev, nullptr);
+        events[0] = ggml_backend_event_new(gpu_dev);
+        events[1] = ggml_backend_event_new(gpu_dev);
+        piece_event = ggml_backend_event_new(gpu_dev);
+        zc_blocks = env_int("LLAMA_EC_ZC_BLOCKS", 16);
+        bool pinned = true;
+        for (auto & L : layers) {
+            for (auto * t : L.src) {
+                const char * bn = ggml_backend_buft_name(ggml_backend_buffer_get_type(t->buffer));
+                pinned = pinned && bn && strstr(bn, "Host") != nullptr;
+            }
+        }
+        if (env_int("LLAMA_EC_ZC", 1) != 0 && pinned) {
+            ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(gpu_dev);
+            zc_copy = (zc_copy_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_zc_copy");
+        }
+        typedef void * (*dev_ptr_fn)(void *);
+        dev_ptr_fn dev_ptr = (dev_ptr_fn) ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(gpu_dev), "ggml_backend_cuda_host_dev_ptr");
+        ggml_backend_buffer_type_t host_buft = ggml_backend_dev_host_buffer_type(gpu_dev);
+        if (mailbox && (!pinned || !dev_ptr || !host_buft || n_helpers <= 0 || max_used > GGML_EC_MAX_K)) {
+            LLAMA_LOG_WARN("%s: mailbox mode needs pinned host experts and a CUDA device; disabled\n", __func__);
+            mailbox = false;
+        }
+        if (mailbox) {
+            int64_t n_embd_max = 0, n_ff_max = 0;
+            size_t xq_max = 0, aq_max = 0;
+            for (auto & L : layers) {
+                if (!L.w_gate) {
+                    continue;
+                }
+                const int64_t ne = L.w_gate->ne[0], nf = L.w_gate->ne[1];
+                n_embd_max = std::max(n_embd_max, ne);
+                n_ff_max   = std::max(n_ff_max, nf);
+                xq_max = std::max(xq_max, ggml_row_size(ggml_get_type_traits_cpu(L.w_gate->type)->vec_dot_type, ne));
+                aq_max = std::max(aq_max, ggml_row_size(ggml_get_type_traits_cpu(L.w_down->type)->vec_dot_type, nf));
+            }
+            y_stride = (n_embd_max + 63) / 64 * 64;
+            y_off    = GGML_EC_MB_X + (n_embd_max * 4 + 255) / 256 * 256;
+            const size_t mb_size = (size_t) y_off + (size_t) max_used * y_stride * sizeof(float);
+            mb_buf = ggml_backend_buft_alloc_buffer(host_buft, mb_size);
+            GGML_ASSERT(mb_buf && "expert cache: failed to allocate the mailbox");
+            mb_host = (char *) ggml_backend_buffer_get_base(mb_buf);
+            memset(mb_host, 0, mb_size);
+            void * mb_dev = dev_ptr(mb_host);
+            const int64_t timeout = (int64_t) env_int("LLAMA_EC_TIMEOUT_MS", 2000) * 2000000;   // cycles (<= 2 GHz)
+            mb_ops.resize(2 * layers.size());
+            for (size_t li = 0; li < layers.size(); ++li) {
+                for (int mode = 0; mode < 2; ++mode) {
+                    ggml_ec_op & o = mb_ops[2 * li + mode];
+                    o.mode = mode;
+                    o.layer = (int32_t) li;
+                    o.y_off = y_off;
+                    o.y_stride = y_stride;
+                    o.mailbox = mb_dev;
+                    o.ctl = nullptr;   // set once the GPU buffer exists
+                    o.timeout_cycles = timeout;
+                }
+            }
+            h_act.assign((size_t) max_used * n_ff_max, 0.0f);
+            h_xq.assign(xq_max + 64, 0);
+            aq_stride = (aq_max + 63) / 64 * 64;
+            h_aq.assign((size_t) max_used * aq_stride + 64, 0);
+        }
+    }
+    if (mailbox) {
+        for (auto & o : mb_ops) {
+            o.ctl = (uint32_t *) ctl->data;
+        }
+        for (int t = 0; t < n_helpers; ++t) {
+            helpers.emplace_back([this, t] { helper_main(t); });
+        }
+    }
+    for (size_t i = 0; i < layers.size(); ++i) {
+        done.emplace_back(new std::atomic<int>[std::max(1, layers[i].C)]);
+        for (int s = 0; s < std::max(1, layers[i].C); ++s) {
+            done.back()[s].store(0);
+        }
+    }
+    if (paced) {
+        copier = std::thread([this] { copier_main(); });
+    }
+
+    // optional initial resident set: a text file of "<layer> <e0> <e1> ..." lines, or a stats JSON
+    // written by LLAMA_EC_STATS, from which the n_slots most requested experts of every layer are taken
+    if (const char * init = getenv("LLAMA_EC_INIT")) {
+        std::ifstream f(init);
+        std::string line;
+        int n_loaded = 0;
+        std::vector<std::string> lines;
+        const std::string ip = init;
+        if (ip.size() > 5 && ip.substr(ip.size() - 5) == ".json") {
+            std::stringstream all;
+            all << f.rdbuf();
+            const std::string js = all.str();
+            size_t pos = 0;
+            while ((pos = js.find("\"il\":", pos)) != std::string::npos) {
+                const int il = atoi(js.c_str() + pos + 5);
+                const size_t c0 = js.find('[', js.find("\"count\":", pos));
+                const size_t c1 = js.find(']', c0);
+                std::vector<std::pair<long long, int>> cnt;
+                std::stringstream cs(js.substr(c0 + 1, c1 - c0 - 1));
+                std::string v;
+                for (int e = 0; std::getline(cs, v, ','); ++e) {
+                    cnt.emplace_back(-atoll(v.c_str()), e);
+                }
+                std::stable_sort(cnt.begin(), cnt.end());
+                std::string l = std::to_string(il);
+                for (auto & [c, e] : cnt) {
+                    l += " " + std::to_string(e);
+                }
+                lines.push_back(l);
+                pos = c1;
+            }
+        } else {
+            while (std::getline(f, line)) {
+                lines.push_back(line);
+            }
+        }
+        for (const auto & ln : lines) {
+            line = ln;
+            std::istringstream ss(line);
+            int il;
+            if (!(ss >> il) || !idx_of.count(il)) {
+                continue;
+            }
+            layer & L = layers[idx_of[il]];
+            int e, s = 0;
+            while (s < L.C && (ss >> e)) {
+                if (e < 0 || e >= L.n_expert || L.slot_of[e] >= 0) {
+                    continue;
+                }
+                for (size_t k = 0; k < L.src.size(); ++k) {
+                    const size_t st = expert_stride(L.src[k]);
+                    ggml_backend_tensor_set(L.slot[k], (const char *) L.src[k]->data + e * st, s * st, st);
+                }
+                L.resident[s] = e;
+                L.slot_of[e] = s;
+                L.cpu_of[e] = -1;
+                ++s;
+                ++n_loaded;
+            }
+        }
+        LLAMA_LOG_INFO("%s: loaded %d experts from %s\n", __func__, n_loaded, init);
+    }
+    // whole-layer residency: expert e lives in slot e, never evicted
+    for (auto & L : layers) {
+        if (L.C == L.n_expert) {
+            for (auto * t : L.slot) { (void) t; }
+            for (size_t k = 0; k < L.src.size(); ++k) {
+                ggml_backend_tensor_set(L.slot[k], L.src[k]->data, 0, ggml_nbytes(L.src[k]));
+            }
+            for (int e = 0; e < L.n_expert; ++e) {
+                L.resident[e] = e;
+                L.slot_of[e] = e;
+                L.cpu_of[e] = -1;
+            }
+        }
+    }
+
+    LLAMA_LOG_INFO("%s: %d MoE layers, %d slots/layer, policy %s, overlap %d, paced %d, zero-copy %d, mailbox %d (%d helpers), %.2f MiB of slots\n", __func__,
+            (int) layers.size(), n_slots, p.c_str(), (int) overlap_cpu, (int) paced, (int) (zc_copy != nullptr), (int) mailbox,
+            mailbox ? n_helpers : 0, ggml_backend_buffer_get_size(buf) / 1024.0 / 1024.0);
+}
+
+llama_expert_cache::~llama_expert_cache() {
+    if (!helpers.empty()) {
+        {
+            std::lock_guard<std::mutex> lk(h_mtx);
+            h_stop.store(true);
+            h_active.store(false);
+        }
+        h_cv.notify_all();
+        for (auto & t : helpers) {
+            t.join();
+        }
+    }
+    if (copier.joinable()) {
+        {
+            std::lock_guard<std::mutex> lk(mtx);
+            stopping = true;
+        }
+        cv.notify_all();
+        copier.join();
+    }
+    if (piece_event) {
+        ggml_backend_event_free(piece_event);
+    }
+    if (!stats_path.empty() && enabled()) {
+        write_stats(stats_path.c_str());
+    }
+    if (copy_backend) {
+        ggml_backend_synchronize(copy_backend);
+    }
+    for (auto * ev : events) {
+        if (ev) {
+            ggml_backend_event_free(ev);
+        }
+    }
+    if (copy_backend) {
+        ggml_backend_free(copy_backend);
+    }
+    if (buf) {
+        ggml_backend_buffer_free(buf);
+    }
+    if (mb_buf) {
+        ggml_backend_buffer_free(mb_buf);
+    }
+    if (ctx) {
+        ggml_free(ctx);
+    }
+}
+
+const llama_expert_cache::layer * llama_expert_cache::get_layer(int il) const {
+    auto it = idx_of.find(il);
+    return it == idx_of.end() ? nullptr : &layers[it->second];
+}
+
+ggml_tensor * llama_expert_cache::slot_for(int il, const ggml_tensor * src) const {
+    const layer * L = get_layer(il);
+    if (!L || !src) {
+        return nullptr;
+    }
+    for (size_t k = 0; k < L->src.size(); ++k) {
+        if (L->src[k] == src) {
+            return L->slot[k];
+        }
+    }
+    return nullptr;
+}
+
+ggml_tensor * llama_expert_cache::routing_view(ggml_context * ctx0, int il, int n_used, int which) {
+    const int i = idx_of.at(il);
+    return ggml_view_1d(ctx0, routing, n_used, (3 * i + which) * routing->nb[1]);
+}
+
+const std::vector<int32_t> & llama_expert_cache::gpu_map(int il) const {
+    return get_layer(il)->slot_of;
+}
+
+const std::vector<int32_t> & llama_expert_cache::cpu_map(int il) const {
+    return get_layer(il)->cpu_of;
+}
+
+int llama_expert_cache::n_expert_max() const {
+    int m = 0;
+    for (const auto & L : layers) {
+        m = std::max(m, L.n_expert);
+    }
+    return m;
+}
+
+void llama_expert_cache::fill_maps(int32_t * dst) const {
+    const int E = n_expert_max();
+    for (size_t i = 0; i < layers.size(); ++i) {
+        const auto & L = layers[i];
+        int32_t * g = dst + (2 * i + 0) * E;
+        int32_t * c = dst + (2 * i + 1) * E;
+        std::fill(g, g + E, -1);
+        std::fill(c, c + E, -1);
+        std::copy(L.slot_of.begin(), L.slot_of.end(), g);
+        std::copy(L.cpu_of.begin(), L.cpu_of.end(), c);
+    }
+}
+
+void llama_expert_cache::copy_expert(const layer & L, int s, int e, bool paced_pieces) {
+    for (size_t k = 0; k < L.src.size(); ++k) {
+        const size_t st = expert_stride(L.src[k]);
+        const char * host = (const char *) L.src[k]->data + (size_t) e * st;
+        if (!copy_backend) {
+            ggml_backend_tensor_set(L.slot[k], host, (size_t) s * st, st);
+            continue;
+        }
+        if (zc_copy && !paced_pieces) {
+            zc_copy(copy_backend, L.slot[k], (size_t) s * st, host, st, zc_blocks);
+            continue;
+        }
+        const size_t piece = chunk > 0 ? chunk : st;
+        for (size_t off = 0; off < st; off += piece) {
+            ggml_backend_tensor_set_async(copy_backend, L.slot[k], host + off, (size_t) s * st + off, std::min(piece, st - off));
+            if (paced_pieces) {  // one piece in flight at a time
+                if (piece_event) {
+                    ggml_backend_event_record(piece_event, copy_backend);
+                    ggml_backend_event_synchronize(piece_event);
+                } else {
+                    ggml_backend_synchronize(copy_backend);
+                }
+            }
+        }
+    }
+}
+
+void llama_expert_cache::copier_main() {
+    while (true) {
+        copy_job j;
+        {
+            std::unique_lock<std::mutex> lk(mtx);
+            cv.wait(lk, [this] { return stopping || !queue.empty(); });
+            if (stopping) {
+                return;
+            }
+            j = queue.front();
+            queue.pop_front();
+        }
+        copy_expert(layers[j.li], j.slot, j.expert, true);
+        done[j.li][j.slot].store(j.expert + 1, std::memory_order_release);
+        pending.fetch_sub(1);
+    }
+}
+
+void llama_expert_cache::admit(layer & L, int s, int e) {
+    L.loading[s] = e;
+    L.load_batch[s] = (int) (step & 1);
+    L.admits++;
+    if (paced) {
+        pending.fetch_add(1);
+        {
+            std::lock_guard<std::mutex> lk(mtx);
+            queue.push_back({ idx_of.at(L.il), s, e });
+        }
+        cv.notify_one();
+        return;
+    }
+    copy_expert(L, s, e, false);
+}
+
+void llama_expert_cache::pre_compute(bool decode) {
+    if (!enabled()) {
+        return;
+    }
+    if (mailbox && decode != h_active.load()) {
+        {
+            std::lock_guard<std::mutex> lk(h_mtx);
+            h_active.store(decode);
+        }
+        h_cv.notify_all();   // parked helpers start spinning on the mailbox (or spinning ones park)
+    }
+    if (paced) {
+        // publish every copy that has completed; never wait
+        for (size_t li = 0; li < layers.size(); ++li) {
+            layer & L = layers[li];
+            for (int s = 0; s < L.C; ++s) {
+                if (L.loading[s] >= 0 && done[li][s].load(std::memory_order_acquire) == L.loading[s] + 1) {
+                    done[li][s].store(0);
+                    const int e = L.loading[s];
+                    L.loading[s]  = -1;
+                    L.resident[s] = e;
+                    L.slot_of[e]  = s;
+                    L.cpu_of[e]   = -1;
+                }
+            }
+        }
+        return;
+    }
+    // publish the copies issued two decode steps ago (they overlapped the previous step)
+    const int b = (int) (step & 1);
+    if (issued[b]) {
+        if (events[b]) {
+            ggml_backend_event_synchronize(events[b]);
+        } else if (copy_backend) {
+            ggml_backend_synchronize(copy_backend);
+        }
+        issued[b] = false;
+    }
+    for (auto & L : layers) {
+        for (int s = 0; s < L.C; ++s) {
+            if (L.loading[s] >= 0 && L.load_batch[s] == b) {
+                const int e = L.loading[s];
+                L.loading[s]  = -1;
+                L.resident[s] = e;
+                L.slot_of[e]  = s;
+                L.cpu_of[e]   = -1;
+            }
+        }
+    }
+}
+
+void llama_expert_cache::post_compute(bool decoded) {
+    if (!enabled() || !decoded) {
+        return;
+    }
+    if (mailbox) {
+        check_mailbox();
+    }
+    ggml_backend_tensor_get(routing, routing_host.data(), 0, ggml_nbytes(routing));
+
+    if (check_ids) {
+        // the ids the graph used must be the host maps (as set before this step) applied to the selection
+        check_steps++;
+        for (size_t li = 0; li < layers.size(); ++li) {
+            const layer & L = layers[li];
+            if (L.C == 0 || L.C == L.n_expert) {
+                continue;
+            }
+            const int32_t * sel = routing_host.data() + (3 * li + 0) * max_used;
+            const int32_t * gid = routing_host.data() + (3 * li + 1) * max_used;
+            const int32_t * cid = routing_host.data() + (3 * li + 2) * max_used;
+            for (int j = 0; j < L.n_used; ++j) {
+                const int e = sel[j];
+                const bool ok = e >= 0 && e < L.n_expert && gid[j] == L.slot_of[e] && cid[j] == L.cpu_of[e] && ((gid[j] >= 0) != (cid[j] >= 0));
+                check_bad += !ok;
+                check_gpu += gid[j] >= 0;
+                check_total++;
+            }
+        }
+        if (check_steps % 256 == 0) {
+            LLAMA_LOG_INFO("%s: check: %llu steps, %llu/%llu ids inconsistent, %.3f served on the GPU\n", __func__,
+                    (unsigned long long) check_steps, (unsigned long long) check_bad, (unsigned long long) check_total,
+                    check_total ? (double) check_gpu / check_total : 0.0);
+        }
+    }
+
+    const double decay = std::pow(0.5, 1.0 / half_life);
+    bool any = false;
+    int budget = max_admit > 0 ? max_admit : INT32_MAX;
+    const size_t nl = layers.size();
+    const size_t first = nl ? (size_t) ((step * 7) % (int64_t) nl) : 0;   // rotate which layer admits first
+
+    for (size_t r = 0; r < nl; ++r) {
+        const size_t li = (first + r) % nl;
+        layer & L = layers[li];
+        if (L.C == 0) {
+            continue; // CPU-only layer: stock path, not observed
+        }
+        const int32_t * sel = routing_host.data() + (3 * li + 0) * max_used;
+        const int k = L.n_used;
+
+        std::vector<int> missed;
+        int n_miss = 0;
+        for (int j = 0; j < k; ++j) {
+            const int e = sel[j];
+            if (e >= 0 && e < L.n_expert && L.slot_of[e] < 0) {
+                n_miss++;
+            }
+        }
+        L.miss_hist[std::min(n_miss, k)]++;
+        for (int j = 0; j < k; ++j) {
+            const int e = sel[j];
+            if (e < 0 || e >= L.n_expert) {
+                continue;
+            }
+            L.count[e]++;
+            L.score[e] = L.score[e] * std::pow(decay, (double) (step - L.last[e])) + 1.0;
+            L.last[e]  = step;
+            if (L.slot_of[e] >= 0) {
+                L.hits++;
+                L.stamp[e] = step;
+            } else {
+                L.misses++;
+                missed.push_back(e);
+            }
+        }
+        if (policy == STATIC || L.C == 0 || L.C == L.n_expert) {
+            continue;
+        }
+        for (int e : missed) {
+            if (budget <= 0 || (paced && max_pending > 0 && pending.load() >= max_pending)) {
+                break;
+            }
+            if (std::find(L.loading.begin(), L.loading.end(), e) != L.loading.end()) {
+                continue; // already on its way
+            }
+            int free_slot = -1;
+            for (int s = 0; s < L.C; ++s) {
+                if (L.resident[s] < 0 && L.loading[s] < 0) {
+                    free_slot = s;
+                    break;
+                }
+            }
+            if (free_slot >= 0) {
+                admit(L, free_slot, e);
+                budget--;
+                any = true;
+                continue;
+            }
+            // victim: resident, not being replaced, not requested this step
+            int victim = -1;
+            double best = 0.0;
+            for (int s = 0; s < L.C; ++s) {
+                const int c = L.resident[s];
+                if (c < 0 || L.loading[s] >= 0 || std::find(sel, sel + k, c) != sel + k) {
+                    continue;
+                }
+                const double key = policy == LRU ? (double) L.stamp[c]
+                                                 : L.score[c] * std::pow(decay, (double) (step - L.last[c]));
+                if (victim < 0 || key < best) {
+                    best = key;
+                    victim = s;
+                }
+            }
+            if (victim < 0) {
+                continue;
+            }
+            if (policy == DFA && !(L.score[e] > best + kappa)) {
+                continue;
+            }
+            const int v = L.resident[victim];
+            L.resident[victim] = -1;
+            L.slot_of[v] = -1;
+            L.cpu_of[v]  = v;
+            admit(L, victim, e);
+            budget--;
+            any = true;
+        }
+    }
+    if (any && !paced) {
+        const int b = (int) (step & 1);
+        if (events[b]) {
+            ggml_backend_event_record(events[b], copy_backend);
+        }
+        issued[b] = true;
+    }
+    step++;
+}
+
+void llama_expert_cache::write_stats(const char * path) const {
+    FILE * f = fopen(path, "w");
+    if (!f) {
+        return;
+    }
+    uint64_t h = 0, m = 0, a = 0;
+    for (const auto & L : layers) {
+        h += L.hits; m += L.misses; a += L.admits;
+    }
+    const char * pn = policy == STATIC ? "static" : policy == LRU ? "lru" : "dfa";
+    fprintf(f, "{\"slots\": %d, \"policy\": \"%s\", \"half_life\": %g, \"kappa\": %g, \"overlap\": %d, \"max_admit\": %d, \"chunk\": %zu, \"paced\": %d, \"max_pending\": %d, \"zc\": %d, \"mailbox\": %d, \"helpers\": %d, \"steps\": %lld,\n",
+            n_slots, pn, half_life, kappa, (int) overlap_cpu, max_admit, chunk, (int) paced, max_pending, (int) (zc_copy != nullptr),
+            (int) mailbox, mailbox ? n_helpers : 0, (long long) step);
+    fprintf(f, " \"check_steps\": %llu, \"check_bad\": %llu, \"check_gpu_frac\": %.6f,\n", (unsigned long long) check_steps,
+            (unsigned long long) check_bad, check_total ? (double) check_gpu / check_total : 0.0);
+    fprintf(f, " \"hits\": %llu, \"misses\": %llu, \"admits\": %llu, \"hit_rate\": %.6f,\n",
+            (unsigned long long) h, (unsigned long long) m, (unsigned long long) a, h + m ? (double) h / (h + m) : 0.0);
+    fprintf(f, " \"mb_busy_us\": [");
+    for (size_t m = 0; m < mb_busy_us.size(); ++m) {
+        fprintf(f, "%s%.1f", m ? "," : "", mb_busy_us[m]);
+    }
+    fprintf(f, "], \"mb_count\": [");
+    for (size_t m = 0; m < mb_count.size(); ++m) {
+        fprintf(f, "%s%llu", m ? "," : "", (unsigned long long) mb_count[m]);
+    }
+    fprintf(f, "],\n \"layers\": [\n");
+    for (size_t i = 0; i < layers.size(); ++i) {
+        const auto & L = layers[i];
+        fprintf(f, "  {\"il\": %d, \"C\": %d, \"hits\": %llu, \"misses\": %llu, \"admits\": %llu, \"mb_requests\": %llu, \"mb_experts\": %llu, ", L.il, L.C,
+                (unsigned long long) L.hits, (unsigned long long) L.misses, (unsigned long long) L.admits,
+                (unsigned long long) L.mb_requests, (unsigned long long) L.mb_experts);
+        fprintf(f, "\"miss_hist\": [");
+        for (size_t m = 0; m < L.miss_hist.size(); ++m) {
+            fprintf(f, "%s%llu", m ? "," : "", (unsigned long long) L.miss_hist[m]);
+        }
+        fprintf(f, "], \"count\": [");
+        for (int e = 0; e < L.n_expert; ++e) {
+            fprintf(f, "%s%llu", e ? "," : "", (unsigned long long) L.count[e]);
+        }
+        fprintf(f, "]}%s\n", i + 1 < layers.size() ? "," : "");
+    }
+    fprintf(f, " ]}\n");
+    fclose(f);
+}
