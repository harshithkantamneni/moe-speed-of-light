diff --git a/ggml/src/ggml-cuda/ec.cu b/ggml/src/ggml-cuda/ec.cu
new file mode 100644
index 0000000..7a935a1
--- /dev/null
+++ b/ggml/src/ggml-cuda/ec.cu
@@ -0,0 +1,144 @@
+#include "ec.cuh"
+
+#include "ggml-ec.h"
+#include "ggml-impl.h"
+
+// Expert-cache mailbox ops (see ggml-ec.h).
+//
+// REQUEST: src[0] = layer input x [n_embd, 1] f32, src[1] = CPU expert ids [k, 1] i32 (-1 = GPU)
+//          dst    = [1] i32 (the published sequence number, 0 if nothing was published)
+// WAIT:    src[0] = CPU expert ids [k, 1] i32, src[1] = REQUEST's dst (ordering only),
+//          src[2] = GPU expert outputs [n_embd, k, 1] f32 (optional: absent for a layer without slots)
+//          dst    = [n_embd, k, 1] f32: row j = helper output if ids[j] >= 0, else GPU row j (or 0)
+
+static const ggml_ec_op * ec_params(const ggml_tensor * dst) {
+    const ggml_custom_op_params * p = (const ggml_custom_op_params *) dst->op_params;
+    return p->fun == ggml_ec_op_stub ? (const ggml_ec_op *) p->userdata : nullptr;
+}
+
+bool ggml_cuda_is_ec_op(const ggml_tensor * dst) {
+    return dst->op == GGML_OP_CUSTOM && ec_params(dst) != nullptr;
+}
+
+static __global__ void ec_request_kernel(const float * __restrict__ x, const int32_t * __restrict__ ids, const int k, const int n_embd,
+                                         const int layer, char * mb, uint32_t * ctl, int32_t * tok) {
+    __shared__ int any;
+    if (threadIdx.x == 0) {
+        int a = 0;
+        for (int j = 0; j < k; ++j) {
+            a |= ids[j] >= 0;
+        }
+        any = a;
+    }
+    __syncthreads();
+    if (!any) {
+        if (threadIdx.x == 0) {
+            tok[0] = 0;
+        }
+        return;
+    }
+    float * mx = (float *) (mb + GGML_EC_MB_X);
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) {
+        mx[i] = x[i];
+    }
+    if (threadIdx.x < k) {
+        ((volatile int32_t *) (mb + GGML_EC_MB_IDS))[threadIdx.x] = ids[threadIdx.x];
+    }
+    if (threadIdx.x == 0) {
+        *(volatile int32_t *) (mb + GGML_EC_MB_LAYER) = layer;
+    }
+    __threadfence_system();   // every writer orders its mailbox writes before the publication below
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        const uint32_t s = ctl[0] + 1;
+        ctl[0] = s;
+        __threadfence_system();
+        *(volatile uint32_t *) (mb + GGML_EC_MB_REQ) = s;
+        tok[0] = (int32_t) s;
+    }
+}
+
+template <bool vec4>
+static __global__ void ec_wait_kernel(const int32_t * __restrict__ ids, const float * __restrict__ g, float * __restrict__ dst,
+                                      const int k, const int n_embd, char * mb, const int64_t y_off, const int64_t y_stride,
+                                      const uint32_t * ctl, const long long timeout) {
+    __shared__ int any;
+    if (threadIdx.x == 0) {
+        int a = 0;
+        for (int j = 0; j < k; ++j) {
+            a |= ids[j] >= 0;
+        }
+        any = a;
+        if (a) {
+            const uint32_t want = ctl[0];
+            const long long t0 = clock64();
+            while (*(volatile uint32_t *) (mb + GGML_EC_MB_RESP) != want) {
+                if (clock64() - t0 > timeout) {
+                    *(volatile int32_t *) (mb + GGML_EC_MB_ERR) = 1;
+                    break;
+                }
+            }
+            __threadfence_system();
+        }
+    }
+    __syncthreads();
+    const float * y = (const float *) (mb + y_off);
+    if (vec4) {
+        const int n4 = n_embd / 4;
+        for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < k * n4; t += gridDim.x * blockDim.x) {
+            const int j = t / n4;
+            const int i = t - j * n4;
+            float4 v;
+            if (ids[j] >= 0) {
+                v = __ldcv((const float4 *) (y + j * y_stride) + i);
+            } else if (g) {
+                v = ((const float4 *) (g + (int64_t) j * n_embd))[i];
+            } else {
+                v = make_float4(0.f, 0.f, 0.f, 0.f);
+            }
+            ((float4 *) (dst + (int64_t) j * n_embd))[i] = v;
+        }
+    } else {
+        for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < k * n_embd; t += gridDim.x * blockDim.x) {
+            const int j = t / n_embd;
+            const int i = t - j * n_embd;
+            dst[(int64_t) j * n_embd + i] = ids[j] >= 0 ? __ldcv(y + j * y_stride + i) : (g ? g[(int64_t) j * n_embd + i] : 0.f);
+        }
+    }
+}
+
+void ggml_cuda_op_ec(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_ec_op * p = ec_params(dst);
+    GGML_ASSERT(p != nullptr);
+    cudaStream_t stream = ctx.stream();
+    if (p->mode == GGML_EC_REQUEST) {
+        const ggml_tensor * x   = dst->src[0];
+        const ggml_tensor * ids = dst->src[1];
+        GGML_ASSERT(x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) && ggml_nrows(x) == 1);
+        GGML_ASSERT(ids->type == GGML_TYPE_I32 && ggml_is_contiguous(ids) && ggml_nelements(ids) <= GGML_EC_MAX_K);
+        const int k = (int) ggml_nelements(ids);
+        ec_request_kernel<<<1, 256, 0, stream>>>((const float *) x->data, (const int32_t *) ids->data, k, (int) x->ne[0],
+                p->layer, (char *) p->mailbox, p->ctl, (int32_t *) dst->data);
+    } else {
+        const ggml_tensor * ids = dst->src[0];
+        const ggml_tensor * g   = dst->src[2];
+        GGML_ASSERT(ids->type == GGML_TYPE_I32 && ggml_is_contiguous(ids));
+        GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+        const int k = (int) ggml_nelements(ids);
+        const int n_embd = (int) dst->ne[0];
+        GGML_ASSERT(dst->ne[1] == k && ggml_nrows(dst) == k);
+        if (g) {
+            GGML_ASSERT(g->type == GGML_TYPE_F32 && ggml_is_contiguous(g) && ggml_are_same_shape(g, dst));
+        }
+        const bool v4 = n_embd % 4 == 0 && p->y_stride % 4 == 0 && p->y_off % 16 == 0;
+        const int n_blocks = 4;
+        if (v4) {
+            ec_wait_kernel<true><<<n_blocks, 256, 0, stream>>>((const int32_t *) ids->data, g ? (const float *) g->data : nullptr,
+                    (float *) dst->data, k, n_embd, (char *) p->mailbox, p->y_off, p->y_stride, p->ctl, p->timeout_cycles);
+        } else {
+            ec_wait_kernel<false><<<n_blocks, 256, 0, stream>>>((const int32_t *) ids->data, g ? (const float *) g->data : nullptr,
+                    (float *) dst->data, k, n_embd, (char *) p->mailbox, p->y_off, p->y_stride, p->ctl, p->timeout_cycles);
+        }
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
