+                 int   il) const {
+    // decode only (one token), no warmup, supported activations, and every expert tensor of the layer cached
+    if (!ec || !ec->enabled() || cparams.warmup || n_tokens != 1 || !ec->get_layer(il)) {
+        return nullptr;
+    }
+    if (type_op != LLM_FFN_SILU && type_op != LLM_FFN_SWIGLU_OAI_MOE) {
+        return nullptr;
+    }
+    if (type_op == LLM_FFN_SILU && il >= 0 && hparams.swiglu_clamp_exp[il] > 1e-6f) {
+        return nullptr;
+    }
+    if (!(gate_exps || gate_up_exps) || n_expert_used != (int64_t) ec->get_layer(il)->n_used) {
+        return nullptr;
+    }
+    for (ggml_tensor * t : { up_exps, up_exps_b, gate_exps, gate_exps_b, down_exps, down_exps_b, gate_up_exps, gate_up_exps_b }) {
+        if (t && !ec->slot_for(il, t)) {
+            return nullptr;
+        }
+    }
+
+    const int C = ec->slots(il);
+    ec->set_act(il, type_op == LLM_FFN_SWIGLU_OAI_MOE ? 1 : 0);
+    const bool mailbox = ec->use_mailbox(il);   // CPU experts go to the helper threads (ggml-ec.h)
+    if (C == 0 && !mailbox) {
+        return nullptr; // CPU-only layer: stock path, experts in host memory (llama.cpp layer offload)
+    }
+    const bool gpu_only = C == ec->get_layer(il)->n_expert; // whole layer resident, expert e in slot e
+
+    ggml_backend_t be_gpu = ggml_backend_sched_get_backend(sched, 0);
+    ggml_backend_t be_cpu = backend_cpu ? backend_cpu : ggml_backend_sched_get_backend(sched, ggml_backend_sched_get_n_backends(sched) - 1);
+
+    // one expert FFN over the entries `ids` selects; entries with id < 0 produce zeros
+    auto path = [&](ggml_tensor * ids, bool on_gpu) -> ggml_tensor * {
+        auto W = [&](ggml_tensor * t) { return on_gpu && t ? ec->slot_for(il, t) : t; };
+        ggml_backend_t be = on_gpu ? be_gpu : be_cpu;
+        std::vector<ggml_tensor *> nodes;
+        auto pin = [&](ggml_tensor * t) { nodes.push_back(t); return t; };
+
+        ggml_tensor * x = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+        ggml_tensor * g = nullptr;
+        ggml_tensor * u = nullptr;
+        if (gate_up_exps) {
+            ggml_tensor * gu = pin(ggml_mul_mat_id(ctx0, W(gate_up_exps), x, ids));
+            if (gate_up_exps_b) {
+                gu = pin(ggml_add_id(ctx0, gu, W(gate_up_exps_b), ids));
+            }
+            const int64_t nff = gu->ne[0] / 2;
+            g = ggml_view_3d(ctx0, gu, nff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], 0);
+            u = ggml_view_3d(ctx0, gu, nff, gu->ne[1], gu->ne[2], gu->nb[1], gu->nb[2], nff * gu->nb[0]);
+        } else {
+            u = pin(ggml_mul_mat_id(ctx0, W(up_exps), x, ids));
+            if (up_exps_b) {
+                u = pin(ggml_add_id(ctx0, u, W(up_exps_b), ids));
+            }
+            g = pin(ggml_mul_mat_id(ctx0, W(gate_exps), x, ids));
+            if (gate_exps_b) {
+                g = pin(ggml_add_id(ctx0, g, W(gate_exps_b), ids));
+            }
+        }
+        ggml_tensor * a = type_op == LLM_FFN_SWIGLU_OAI_MOE
+            ? pin(ggml_swiglu_oai(ctx0, g, u, 1.702f, 7.0f))
+            : pin(ggml_swiglu_split(ctx0, g, u));
+        ggml_tensor * d = pin(ggml_mul_mat_id(ctx0, W(down_exps), a, ids));
+        if (down_exps_b) {
+            d = pin(ggml_add_id(ctx0, d, W(down_exps_b), ids));
+        }
+        for (ggml_tensor * t : nodes) {
+            ggml_backend_sched_set_tensor_backend(sched, t, be);
+        }
+        return d;
+    };
+
+    if (gpu_only) {
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, ggml_reshape_1d(ctx0, selected_experts, n_expert_used),
+                ec->routing_view(ctx0, il, (int) n_expert_used)));
+        ggml_tensor * out = path(selected_experts, true);
+        cb(out, "ffn_moe_ec_gpu_only", il);
+        return out;
+    }
+
+    if (mailbox && C == 0) {
+        // every selected expert runs on the helpers; the GPU only hands the input over and collects the result
+        ggml_tensor * x   = ggml_reshape_2d(ctx0, cur, n_embd, n_tokens);
+        ggml_tensor * cid = ggml_reshape_2d(ctx0, selected_experts, n_expert_used, n_tokens);
+        ggml_tensor * req_args[2] = { x, cid };
+        ggml_tensor * req = ggml_custom_4d(ctx0, GGML_TYPE_I32, 1, 1, 1, 1, req_args, 2, ggml_ec_op_stub, 1,
+                ec->mailbox_op(il, GGML_EC_REQUEST));
+        ggml_format_name(req, "ec_req-%d", il);
+        ggml_backend_sched_set_tensor_backend(sched, req, be_gpu);
+        ggml_build_forward_expand(gf, req);
+        ggml_tensor * wait_args[2] = { cid, req };
+        ggml_tensor * out = ggml_custom_4d(ctx0, GGML_TYPE_F32, n_embd, n_expert_used, n_tokens, 1, wait_args, 2, ggml_ec_op_stub, 1,
+                ec->mailbox_op(il, GGML_EC_WAIT));
+        ggml_format_name(out, "ec_wait-%d", il);
+        ggml_backend_sched_set_tensor_backend(sched, out, be_gpu);
+        cb(out, "ffn_moe_ec_helpers", il);
+        return out;
+    }
+
+    if (!inp_ec) {
+        auto inp = std::make_unique<llm_graph_input_expert_cache>(ec);
+        inp_ec = inp.get();
+        inp_ec->maps = ggml_new_tensor_2d(ctx0, GGML_TYPE_I32, ec->n_expert_max(), 2 * ec->n_layers());
+        ggml_set_input(inp_ec->maps);
+        ggml_set_name(inp_ec->maps, "ec_maps");
+        res->add_input(std::move(inp));
+    }
+    GGML_ASSERT(n_expert <= ec->n_expert_max());
+    const int li = ec->layer_index(il);
+    ggml_tensor * maps = inp_ec->maps;
+    ggml_tensor * map_g = ggml_view_2d(ctx0, maps, 1, n_expert, sizeof(int32_t), (size_t) (2 * li + 0) * maps->nb[1]);
+    ggml_tensor * map_c = ggml_view_2d(ctx0, maps, 1, n_expert, sizeof(int32_t), (size_t) (2 * li + 1) * maps->nb[1]);
+
+    // record this step's selection for the cache policy
+    {
+        ggml_tensor * sel = ggml_reshape_1d(ctx0, selected_experts, n_expert_used);
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, sel, ec->routing_view(ctx0, il, (int) n_expert_used)));
+    }
+
+    ggml_tensor * gr_g = ggml_get_rows(ctx0, map_g, selected_experts); // [1, n_expert_used, n_tokens]
+    ggml_tensor * gr_c = ggml_get_rows(ctx0, map_c, selected_experts);
+    ggml_format_name(gr_g, "ec_gid-%d", il);
+    ggml_format_name(gr_c, "ec_cid-%d", il);
+    ggml_backend_sched_set_tensor_backend(sched, gr_g, be_gpu);
+    ggml_backend_sched_set_tensor_backend(sched, gr_c, be_gpu);
+    ggml_tensor * gid = ggml_reshape_2d(ctx0, gr_g, n_expert_used, n_tokens);
+    ggml_tensor * cid = ggml_reshape_2d(ctx0, gr_c, n_expert_used, n_tokens);
+    ggml_build_forward_expand(gf, gid);
+    ggml_build_forward_expand(gf, cid);
+    if (ec->check()) {
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, ggml_reshape_1d(ctx0, gr_g, n_expert_used), ec->routing_view(ctx0, il, (int) n_expert_used, 1)));
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, ggml_reshape_1d(ctx0, gr_c, n_expert_used), ec->routing_view(ctx0, il, (int) n_expert_used, 2)));
+    }
+
+    if (mailbox) {
+        // hand the CPU experts to the helpers first, compute the resident ones on the GPU meanwhile, then merge
+        ggml_tensor * x = ggml_reshape_2d(ctx0, cur, n_embd, n_tokens);
+        ggml_tensor * req_args[2] = { x, cid };
+        ggml_tensor * req = ggml_custom_4d(ctx0, GGML_TYPE_I32, 1, 1, 1, 1, req_args, 2, ggml_ec_op_stub, 1,
+                ec->mailbox_op(il, GGML_EC_REQUEST));
+        ggml_format_name(req, "ec_req-%d", il);
+        ggml_backend_sched_set_tensor_backend(sched, req, be_gpu);
+        ggml_build_forward_expand(gf, req);
+        ggml_tensor * out_gpu = path(gid, true);
+        cb(out_gpu, "ffn_moe_ec_gpu", il);
+        ggml_build_forward_expand(gf, out_gpu);
+        ggml_tensor * wait_args[3] = { cid, req, out_gpu };
+        ggml_tensor * out = ggml_custom_4d(ctx0, GGML_TYPE_F32, n_embd, n_expert_used, n_tokens, 1, wait_args, 3, ggml_ec_op_stub, 1,
+                ec->mailbox_op(il, GGML_EC_WAIT));
+        ggml_format_name(out, "ec_wait-%d", il);
+        ggml_backend_sched_set_tensor_backend(sched, out, be_gpu);
+        cb(out, "ffn_moe_ec_merged", il);
+        return out;
+    }
+
+    const int n_before = ggml_graph_n_nodes(gf);
+    ggml_tensor * out_gpu = path(gid, true);
+    cb(out_gpu, "ffn_moe_ec_gpu", il);
+    ggml_build_forward_expand(gf, out_gpu);
+    if (ec->overlap()) {
+        // start a scheduler split at the first GPU-path node so the CPU path can run beside it
+        for (int i = n_before; i < ggml_graph_n_nodes(gf); ++i) {
+            ggml_tensor * t = ggml_graph_node(gf, i);
+            if (t->op != GGML_OP_RESHAPE && t->op != GGML_OP_VIEW && t->op != GGML_OP_PERMUTE && t->op != GGML_OP_TRANSPOSE) {
+                t->flags |= GGML_TENSOR_FLAG_SPLIT_BEFORE;
+                break;
+            }
+        }
+    }
+    ggml_tensor * out_cpu = path(cid, false);
+    cb(out_cpu, "ffn_moe_ec_cpu", il);
+    ggml_build_forward_expand(gf, out_cpu);
+
+    ggml_tensor * experts = ggml_add(ctx0, out_gpu, out_cpu); // [n_embd, n_expert_used, n_tokens]
+    ggml_backend_sched_set_tensor_backend(sched, experts, be_gpu);
+    cb(experts, "ffn_moe_ec_merged", il);
+    return experts;
+}
