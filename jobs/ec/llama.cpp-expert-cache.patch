+ggml_ec_op * llama_expert_cache::mailbox_op(int il, int mode) {
+    return &mb_ops[2 * idx_of.at(il) + mode];
+}
+
+void llama_expert_cache::set_act(int il, int act) {
+    auto it = idx_of.find(il);
+    if (it != idx_of.end()) {
+        layers[it->second].act = act;
+    }
+}
+
+void llama_expert_cache::check_mailbox() {
+    if (*(volatile int32_t *) (mb_host + GGML_EC_MB_ERR) != 0) {
+        GGML_ABORT("expert cache: a GPU wait for the mailbox helpers timed out");
+    }
+}
+
+void llama_expert_cache::helper_barrier() {
+    const int gen = bar_gen.load(std::memory_order_acquire);
+    if (bar_count.fetch_add(1, std::memory_order_acq_rel) == n_helpers - 1) {
+        bar_count.store(0, std::memory_order_relaxed);
+        bar_gen.fetch_add(1, std::memory_order_acq_rel);
+    } else {
+        while (bar_gen.load(std::memory_order_acquire) == gen) {
+            cpu_relax();
+        }
+    }
+}
+
+static int64_t now_us() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+void llama_expert_cache::helper_main(int ith) {
+#if defined(__linux__)
+    if (pin_helpers) {
+        const int ncpu = (int) std::thread::hardware_concurrency();
+        cpu_set_t cs;
+        CPU_ZERO(&cs);
+        CPU_SET((ith + 1) % std::max(1, ncpu), &cs);
+        pthread_setaffinity_np(pthread_self(), sizeof(cs), &cs);
+    }
+#endif
+    const volatile uint32_t * req = (const volatile uint32_t *) (mb_host + GGML_EC_MB_REQ);
+    uint32_t seen = 0;
+    while (true) {
+        if (!h_active.load(std::memory_order_acquire)) {
+            std::unique_lock<std::mutex> lk(h_mtx);
+            h_cv.wait(lk, [this] { return h_stop.load() || h_active.load(); });
+            if (h_stop.load()) {
+                return;
+            }
+            continue;
+        }
+        const uint32_t s = *req;
+        if (s == seen) {
+            cpu_relax();
+            continue;
+        }
+        std::atomic_thread_fence(std::memory_order_acquire);
+        seen = s;
+        helper_serve(ith, s);
+    }
+}
+
+// quantize n values (a multiple of the block size) into the vec_dot type; blocks [ith, nth) split
+static void ec_quantize_part(const float * x, int64_t n, ggml_type vdt, char * dst, int ith, int nth) {
+    if (vdt == GGML_TYPE_F32) {
+        const int64_t i0 = n * ith / nth, i1 = n * (ith + 1) / nth;
+        memcpy(dst + i0 * sizeof(float), x + i0, (i1 - i0) * sizeof(float));
+        return;
+    }
+    const int64_t bs = ggml_blck_size(vdt);
+    const int64_t nb = n / bs;
+    const int64_t b0 = nb * ith / nth, b1 = nb * (ith + 1) / nth;
+    if (b1 > b0) {
+        ggml_get_type_traits_cpu(vdt)->from_float(x + b0 * bs, dst + b0 * ggml_type_size(vdt), (b1 - b0) * bs);
+    }
+}
+
+void llama_expert_cache::helper_serve(int ith, uint32_t seq) {
+    const int nth = n_helpers;
+    if (ith == 0) {
+        t_req_us = now_us();
+    }
+    const int li = *(const volatile int32_t *) (mb_host + GGML_EC_MB_LAYER);
+    const int32_t * ids = (const int32_t *) (mb_host + GGML_EC_MB_IDS);
+    const float * x = (const float *) (mb_host + GGML_EC_MB_X);
+    layer & L = layers[li];
+
+    int js[GGML_EC_MAX_K], es[GGML_EC_MAX_K], m = 0;
+    for (int j = 0; j < L.n_used; ++j) {
+        if (ids[j] >= 0) {
+            js[m] = j;
+            es[m] = ids[j];
+            m++;
+        }
+    }
+    const int64_t n_embd = L.w_gate->ne[0];
+    const int64_t n_ff   = L.w_gate->ne[1];
+    const auto * tg = ggml_get_type_traits_cpu(L.w_gate->type);
+    const auto * tu = ggml_get_type_traits_cpu(L.w_up->type);
+    const auto * td = ggml_get_type_traits_cpu(L.w_down->type);
+    const ggml_type vgu = tg->vec_dot_type;
+    const ggml_type vd  = td->vec_dot_type;
+    GGML_ASSERT(tu->vec_dot_type == vgu);
+
+    // 0: the input, quantized once (split over the helpers)
+    ec_quantize_part(x, n_embd, vgu, h_xq.data(), ith, nth);
+    helper_barrier();
+
+    // 1: gate and up rows of every CPU expert, bias, activation
+    {
+        const int64_t U = (int64_t) m * n_ff;
+        const int64_t u0 = U * ith / nth, u1 = U * (ith + 1) / nth;
+        const bool oai = L.act == 1;
+        for (int64_t u = u0; u < u1; ++u) {
+            const int q = (int) (u / n_ff);
+            const int64_t r = u - q * n_ff;
+            const int e = es[q];
+            float g = 0.0f, up = 0.0f;
+            tg->vec_dot((int) n_embd, &g,  0, (const char *) L.w_gate->data + e * L.w_gate->nb[2] + r * L.w_gate->nb[1], 0, h_xq.data(), 0, 1);
+            tu->vec_dot((int) n_embd, &up, 0, (const char *) L.w_up->data   + e * L.w_up->nb[2]   + r * L.w_up->nb[1],   0, h_xq.data(), 0, 1);
+            if (L.b_gate) {
+                g  += *(const float *) ((const char *) L.b_gate->data + e * L.b_gate->nb[1] + r * sizeof(float));
+            }
+            if (L.b_up) {
+                up += *(const float *) ((const char *) L.b_up->data + e * L.b_up->nb[1] + r * sizeof(float));
+            }
+            float a;
+            if (oai) {   // ggml swiglu_oai, alpha 1.702, limit 7 (as in llm_graph_context::build_moe_ffn)
+                const float xg = std::min(g, 7.0f);
+                const float yu = std::max(std::min(up, 7.0f), -7.0f);
+                a = xg / (1.0f + expf(1.702f * (-xg))) * (yu + 1.0f);
+            } else {     // swiglu: silu(gate) * up
+                a = g / (1.0f + expf(-g)) * up;
+            }
+            h_act[(size_t) q * n_ff + r] = a;
+        }
+    }
+    helper_barrier();
+
+    // 2: activations quantized (split over the helpers)
+    for (int q = 0; q < m; ++q) {
+        ec_quantize_part(h_act.data() + (size_t) q * n_ff, n_ff, vd, h_aq.data() + (size_t) q * aq_stride, ith, nth);
+    }
+    helper_barrier();
+
+    // 3: down rows and bias, written straight into the mailbox rows the GPU will read
+    {
+        float * y = (float *) (mb_host + y_off);
+        const int64_t V = (int64_t) m * n_embd;
+        const int64_t v0 = V * ith / nth, v1 = V * (ith + 1) / nth;
+        for (int64_t v = v0; v < v1; ++v) {
+            const int q = (int) (v / n_embd);
+            const int64_t r = v - q * n_embd;
+            const int e = es[q];
+            float d = 0.0f;
+            td->vec_dot((int) n_ff, &d, 0, (const char *) L.w_down->data + e * L.w_down->nb[2] + r * L.w_down->nb[1], 0,
+                    h_aq.data() + (size_t) q * aq_stride, 0, 1);
+            if (L.b_down) {
+                d += *(const float *) ((const char *) L.b_down->data + e * L.b_down->nb[1] + r * sizeof(float));
+            }
+            y[(size_t) js[q] * y_stride + r] = d;
+        }
+    }
+    if (ith == 0) {
+        L.mb_requests++;
+        L.mb_experts += m;
+    }
+    // the last helper to finish publishes the answer
+    if (done_count.fetch_add(1, std::memory_order_acq_rel) == nth - 1) {
+        done_count.store(0, std::memory_order_relaxed);
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+        *(volatile uint32_t *) (mb_host + GGML_EC_MB_RESP) = seq;
+        mb_busy_us[std::min(m, (int) mb_busy_us.size() - 1)] += (double) (now_us() - t_req_us);
+        mb_count[std::min(m, (int) mb_count.size() - 1)]++;
+    }
+}
diff --git a/src/llama-expert-cache.h b/src/llama-expert-cache.h
new file mode 100644
index 0000000..35ff5fd
--- /dev/null
+++ b/src/llama-expert-cache.h
@@ -0,0 +1,201 @@
+#pragma once
+
+// Expert cache for MoE decode with experts resident in host memory.
+//
+// Every MoE layer keeps `slots` expert copies in GPU memory. At each decode
+// step the router's selection is split in the graph: experts resident in a
+// slot ("hits") run on the GPU from the slot, the others ("misses") run on the
+// CPU from host memory, and the two partial results are summed. After each
+// step a policy decides which missed experts to copy into slots; the copies
+// run asynchronously on a separate stream and take effect one step later.
+//
+// Configured through environment variables (research prototype):
+//   LLAMA_EC_SLOTS      slots per MoE layer (0 or unset = off)
+//   LLAMA_EC_ALLOC      file of "<layer> <slots>" lines overriding LLAMA_EC_SLOTS per layer: 0 = the layer's experts
+//                       stay on the CPU as in llama.cpp's layer offload (no GPU path, no hand-off added);
+//                       n_expert = the whole layer is resident on the GPU (no CPU path, no hand-off);
+//                       anything between = a cached layer (both paths)
+//   LLAMA_EC_POLICY     static | lru | dfa           (default dfa)
+//   LLAMA_EC_HALF_LIFE  dfa decay half-life in decode steps (default 16)
+//   LLAMA_EC_KAPPA      dfa admission margin (default 0)
+//   LLAMA_EC_INIT       file with the initial resident set: one line per MoE layer,
+//                       "<layer> <e0> <e1> ..." (optional; static uses it as the fixed set)
+//   LLAMA_EC_OVERLAP    1 = run GPU hits concurrently with CPU misses (default 1)
+//   LLAMA_EC_STATS      file to write per-layer statistics and expert counts at exit
+//   LLAMA_EC_MAX_ADMIT  at most this many slot copies per decode step over all layers (0 = no limit);
+//                       layers take turns being first, so no layer is starved
+//   LLAMA_EC_CHUNK      issue slot copies in pieces of this many bytes (0 = one copy per tensor)
+//   LLAMA_EC_PACED      1 (default) = a copy thread keeps at most one piece in flight, so the step's own
+//                       small host<->device transfers never queue behind admissions; a slot is used from the
+//                       first step after its copy completes. 0 = all of a step's copies are queued at once
+//                       and published two steps later.
+//   LLAMA_EC_MAX_PENDING  paced mode: no new admissions while this many copies are queued (0 = no limit)
+//   LLAMA_EC_ZC         1 (default, CUDA with pinned experts) = slot copies are done by a copy kernel reading
+//                       pinned host memory (SM loads), not by the copy engine that carries the step's own
+//                       host<->device transfers; 0 = cudaMemcpyAsync
+//   LLAMA_EC_ZC_BLOCKS  thread blocks of that kernel (default 16)
+//   LLAMA_EC_CHECK      1 = the graph also records the per-layer GPU/CPU ids it used, checked against the host maps
+//   LLAMA_EC_MAILBOX    1 = decode hands a layer's CPU experts to helper threads through a mailbox in pinned memory,
+//                       signalled from the GPU (ggml-ec.h), instead of splitting the graph between the GPU and
+//                       the CPU backend: no host-driven synchronization per layer, and a layer whose selected
+//                       experts are all resident never involves the CPU. Layers with 0 slots also run their
+//                       experts on the helpers.
+//   LLAMA_EC_HELPERS    helper threads in mailbox mode (default: hardware threads - 2)
+//   LLAMA_EC_TIMEOUT_MS a GPU wait for the helpers gives up after this long (default 2000; the step then aborts)
+//   LLAMA_EC_PIN       1 = pin helper i to CPU i+1 (CPU 0 is left to the thread driving the GPU)
+
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-ec.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <map>
+#include <string>
+#include <vector>
+
+struct llama_model;
+
+struct llama_expert_cache {
+    enum policy_t { STATIC = 0, LRU = 1, DFA = 2 };
+
+    struct layer {
+        int il = -1;
+        int n_expert = 0;
+        int n_used = 0;
+        int C = 0;                        // slots of this layer (0 = CPU only, n_expert = GPU only)
+        std::vector<ggml_tensor *> src;   // host-resident expert tensors (weights and per-expert biases)
+        std::vector<ggml_tensor *> slot;  // GPU slot tensors, same order as src
+        std::vector<int32_t> slot_of;     // [E]  expert -> slot, or -1
+        std::vector<int32_t> cpu_of;      // [E]  expert -> expert if served by the CPU, else -1
+        std::vector<int32_t> resident;    // [C]  slot -> expert, or -1
+        std::vector<int32_t> loading;     // [C]  slot -> expert being copied in, or -1
+        std::vector<int>     load_batch;  // [C]  copy batch (step parity) of the pending load
+        std::vector<double>  score;       // [E]  decayed request count (dfa)
+        std::vector<int64_t> last;        // [E]  last step the score was updated
+        std::vector<int64_t> stamp;       // [E]  last step the expert was used (lru)
+        std::vector<uint64_t> count;      // [E]  total requests
+        uint64_t hits = 0, misses = 0, admits = 0;
+        // mailbox mode: the host expert tensors the helpers compute from, and the activation (0 swiglu, 1 swiglu_oai)
+        ggml_tensor * w_gate = nullptr, * w_up = nullptr, * w_down = nullptr;
+        ggml_tensor * b_gate = nullptr, * b_up = nullptr, * b_down = nullptr;
+        int act = -1;
+        uint64_t mb_requests = 0;         // requests the helpers served for this layer
+        uint64_t mb_experts = 0;          // experts they computed
+        std::vector<uint64_t> miss_hist;  // [n_used+1] decode steps with m of the selected experts not resident
+    };
+
+    llama_expert_cache(const llama_model & model, ggml_backend_t gpu_backend, ggml_backend_dev_t gpu_dev);
+    ~llama_expert_cache();
+
+    bool enabled() const { return n_slots > 0 && !layers.empty(); }
+    int slots(int il) const { const layer * L = get_layer(il); return L ? L->C : 0; }
+    bool overlap() const { return overlap_cpu; }
+
+    // graph building
+    const layer * get_layer(int il) const;
+    ggml_tensor * slot_for(int il, const ggml_tensor * src) const;   // nullptr if src is not cached
+    ggml_tensor * routing_view(ggml_context * ctx, int il, int n_used, int which = 0); // 0 sel, 1 gpu ids, 2 cpu ids
+    bool check() const { return check_ids; }
+
+    // host-side maps copied into the graph inputs before every step
+    const std::vector<int32_t> & gpu_map(int il) const;
+    const std::vector<int32_t> & cpu_map(int il) const;
+    int layer_index(int il) const { return idx_of.at(il); }
+    int n_layers() const { return (int) layers.size(); }
+    int n_expert_max() const;
+    void fill_maps(int32_t * dst) const;   // [n_layers][2][n_expert_max]: gpu map, cpu map
+
+    // mailbox mode
+    bool use_mailbox(int il) const;                         // the decode graph hands this layer's CPU experts to the helpers
+    ggml_ec_op * mailbox_op(int il, int mode);  // userdata of the layer's REQUEST / WAIT op
+    void set_act(int il, int act);                          // 0 swiglu, 1 swiglu_oai (set while building the graph)
+
+    // decode loop hooks
+    void pre_compute(bool decode);      // finish copies issued two steps ago, publish them; wake/park the helpers
+    void post_compute(bool decoded);    // read this step's routing, run the policy, issue copies
+
+    void write_stats(const char * path) const;
+
+    int n_slots = 0;
+    policy_t policy = DFA;
+    double half_life = 16.0;
+    double kappa = 0.0;
+    bool overlap_cpu = true;
+    bool check_ids = false;
+    int max_admit = 0;
+    size_t chunk = 0;
+    bool paced = true;
+    int max_pending = 0;
+    int zc_blocks = 16;
+    typedef void (*zc_copy_fn)(ggml_backend_t, ggml_tensor *, size_t, const void *, size_t, int);
+    zc_copy_fn zc_copy = nullptr;
+    std::string stats_path;
+    uint64_t check_steps = 0, check_bad = 0, check_gpu = 0, check_total = 0;
+    bool mailbox = false;
+    int  n_helpers = 0;
+    bool pin_helpers = false;
+    // helper service time (first helper sees the request -> answer published), by number of experts computed
+    std::vector<double>   mb_busy_us;     // [n_used+1]
+    std::vector<uint64_t> mb_count;       // [n_used+1]
+
+private:
+    // mailbox mode
+    ggml_backend_buffer_t mb_buf = nullptr;     // pinned host memory, device-mapped
+    char * mb_host = nullptr;
+    ggml_tensor * ctl = nullptr;                // GPU counters of the mailbox ops
+    int64_t y_off = 0, y_stride = 0;
+    std::vector<ggml_ec_op> mb_ops;             // [2 * n_layers]: REQUEST, WAIT of every layer
+    std::vector<std::thread> helpers;
+    std::atomic<bool> h_active{false};
+    std::atomic<bool> h_stop{false};
+    std::mutex h_mtx;
+    std::condition_variable h_cv;
+    std::atomic<int> bar_count{0};
+    std::atomic<int> bar_gen{0};
+    std::atomic<int> done_count{0};
+    std::vector<float> h_act;                   // [k][n_ff] activations of the experts being computed
+    std::vector<char>  h_xq;                    // quantized layer input
+    std::vector<char>  h_aq;                    // [k] quantized activations
+    size_t aq_stride = 0;
+    int64_t t_req_us = 0;                       // set by helper 0 when it picks up a request
+    void helper_main(int ith);
+    void helper_serve(int ith, uint32_t seq);
+    void helper_barrier();
+    void check_mailbox();
+
+    void admit(layer & L, int slot, int e);
+
+    std::vector<layer> layers;
+    std::map<int, int> idx_of;          // il -> index in layers
+
+    ggml_context * ctx = nullptr;       // slot and routing tensor metadata
+    ggml_backend_buffer_t buf = nullptr;
+    ggml_tensor * routing = nullptr;    // [n_used, 3*n_moe_layers] I32 (sel, gpu ids, cpu ids), written by the graph
+    std::vector<int32_t> routing_host;
+
+    // paced copies: a thread drains the queue one piece at a time
+    struct copy_job { int li; int slot; int expert; };
+    std::thread copier;
+    std::mutex mtx;
+    std::condition_variable cv;
+    std::deque<copy_job> queue;
+    bool stopping = false;
+    std::atomic<int> pending{0};
+    std::vector<std::unique_ptr<std::atomic<int>[]>> done;   // [layer][slot]: expert+1 once its copy completed
+    ggml_backend_event_t piece_event = nullptr;
+    void copier_main();
+    void copy_expert(const layer & L, int s, int e, bool paced_pieces);
+
+    ggml_backend_t copy_backend = nullptr;      // separate stream for slot copies (GPU only)
+    ggml_backend_event_t events[2] = {nullptr, nullptr};
+    bool issued[2] = {false, false};
+
+    int64_t step = 0;
+    int max_used = 0;
+};
