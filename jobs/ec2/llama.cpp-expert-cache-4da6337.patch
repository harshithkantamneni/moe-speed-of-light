diff --git a/ggml/include/ggml-ec.h b/ggml/include/ggml-ec.h
new file mode 100644
index 0000000..716cb16
--- /dev/null
+++ b/ggml/include/ggml-ec.h
@@ -0,0 +1,87 @@
+#pragma once
+
+// Device-driven CPU hand-off for MoE decode (expert cache "mailbox" mode).
+//
+// A decode step's graph stays on the GPU. For a MoE layer whose selected experts are partly or wholly
+// served from host memory, two GPU ops bracket the GPU part of the layer:
+//
+//   REQUEST  if any selected expert is served by the CPU: write the layer input and the CPU expert ids
+//            into a mailbox in pinned host memory and publish a sequence number. Otherwise do nothing.
+//   WAIT     if a request was published: spin (on the GPU) until the CPU helper answers that sequence
+//            number, then merge the helper's per-expert outputs with the GPU's.
+//
+// CPU helper threads spin on the mailbox during decode, compute the missed experts from host memory and
+// publish the answer. There is no host-driven synchronization, copy or graph launch per layer, and a layer
+// whose experts are all resident on the GPU never involves the CPU.
+//
+// Both ops are GGML_OP_CUSTOM nodes whose function is ggml_ec_op_stub (they have no CPU implementation)
+// and whose userdata is a struct ggml_ec_op.
+
+#include "ggml.h"
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GGML_EC_MB_REQ    0      // uint32 request sequence number (written by the GPU)
+#define GGML_EC_MB_RESP   128    // uint32 answered sequence number (written by the CPU)
+#define GGML_EC_MB_ERR    256    // int32  set by the GPU when a wait timed out
+#define GGML_EC_MB_LAYER  384    // int32  layer index of the request
+#define GGML_EC_MB_IDS    512    // int32[GGML_EC_MAX_K] CPU expert id per selected slot, -1 = served by the GPU
+#define GGML_EC_MB_X      4096   // float[n_embd_max] layer input
+#define GGML_EC_MAX_K     64
+
+enum ggml_ec_mode {
+    GGML_EC_REQUEST = 0,
+    GGML_EC_WAIT    = 1,
+    GGML_EC_FETCH   = 2,   // decide which of this step's misses move into slots (see below)
+    GGML_EC_FETCH_COPY = 3,   // copy them; placed after REQUEST so the helpers start first and the copy overlaps them
+    GGML_EC_PREFETCH      = 4,   // decide which predicted experts of the NEXT layer to copy into its slots (see below)
+    GGML_EC_PREFETCH_COPY = 5,   // start that copy on a side stream (it overlaps the rest of this layer and the next
+                                 // layer's attention)
+    GGML_EC_PREFETCH_JOIN = 6,   // in the next layer, before its GPU experts run: wait for the copy
+};
+
+// PREFETCH: while layer l runs, the router of layer l+1 applied to layer l's MoE input (with layer l+1's norm weight,
+// folded into a precomputed matrix) predicts layer l+1's experts. Up to `q` of the top `npred` predictions that are not
+// resident are copied from pinned host memory into layer l+1's eviction candidates (never a slot holding a predicted
+// expert) on a side stream, and layer l+1's maps are updated so that they are served there. The plan op's output is
+// [gpu map (E) | cpu map (E) | eviction candidates (E) | n | (expert, slot) pairs], logged for the host like FETCH.
+// The copy uses the target layer's struct ggml_ec_fetch (table[0] = q) and its own log.
+
+// FETCH: when m of a layer's selected experts miss, copy table[m] of them (in selection order, i.e. highest router
+// weight first) from pinned host memory into the layer's eviction candidates (a slot list the host ranks by decayed
+// score before every step, skipping slots in use this step) with a kernel that reads the host memory directly, and
+// serve them on the GPU this step; the rest go to the helpers. The (expert, slot) pairs are logged for the host.
+#define GGML_EC_FETCH_MAX_T 8
+struct ggml_ec_fetch {
+    int32_t      n_t;                              // expert tensors of the layer (weights, then per-expert biases)
+    int32_t      blocks;                           // thread blocks of the copy kernel
+    int32_t      copy_in_plan;                     // 1 = FETCH copies right away (no FETCH_COPY op in the graph)
+    int32_t      table[GGML_EC_MAX_K + 1];         // experts to fetch when m selected experts miss
+    const void * src[GGML_EC_FETCH_MAX_T];         // device pointers of the pinned host expert tensors
+    void       * slot[GGML_EC_FETCH_MAX_T];        // device pointers of the slot tensors
+    int64_t      stride[GGML_EC_FETCH_MAX_T];      // bytes per expert of each tensor
+    int32_t    * log;                              // device pointer into pinned host memory: n, then (expert, slot) pairs
+    int32_t      n_expert;                         // PREFETCH: experts of the target layer (map length)
+};
+
+struct ggml_ec_op {
+    int32_t   mode;           // enum ggml_ec_mode
+    int32_t   layer;          // index the CPU helper uses to find the layer's host expert tensors
+    int64_t   y_off;          // byte offset of the output rows in the mailbox
+    int64_t   y_stride;       // floats between output rows (one row per selected slot)
+    void    * mailbox;        // device pointer of the pinned mailbox
+    uint32_t* ctl;            // device memory: [0] = last request sequence number
+    int64_t   timeout_cycles; // a wait gives up (and sets GGML_EC_MB_ERR) after this many GPU clock cycles
+    const struct ggml_ec_fetch * fetch;   // FETCH only
+};
+
+// the CPU "implementation" of the mailbox ops: aborts (they must be placed on the GPU)
+GGML_API void ggml_ec_op_stub(struct ggml_tensor * dst, int ith, int nth, void * userdata);
+
+#ifdef __cplusplus
+}
+#endif
