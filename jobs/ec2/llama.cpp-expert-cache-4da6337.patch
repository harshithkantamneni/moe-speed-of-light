diff --git a/ggml/src/ggml-cuda/ec.cu b/ggml/src/ggml-cuda/ec.cu
new file mode 100644
index 0000000..4a098d3
--- /dev/null
+++ b/ggml/src/ggml-cuda/ec.cu
@@ -0,0 +1,373 @@
+#include "ec.cuh"
+
+#include "ggml-ec.h"
+#include "ggml-impl.h"
+
+#include <vector>
+
+// Expert-cache mailbox ops (see ggml-ec.h).
+//
+// REQUEST: src[0] = layer input x [n_embd, 1] f32, src[1] = CPU expert ids [k, 1] i32 (-1 = GPU)
+//          dst    = [1] i32 (the published sequence number, 0 if nothing was published)
+// WAIT:    src[0] = CPU expert ids [k, 1] i32, src[1] = REQUEST's dst (ordering only),
+//          src[2] = GPU expert outputs [n_embd, k, 1] f32 (optional: absent for a layer without slots)
+//          dst    = [n_embd, k, 1] f32: row j = helper output if ids[j] >= 0, else GPU row j (or 0)
+
+static const ggml_ec_op * ec_params(const ggml_tensor * dst) {
+    const ggml_custom_op_params * p = (const ggml_custom_op_params *) dst->op_params;
+    return p->fun == ggml_ec_op_stub ? (const ggml_ec_op *) p->userdata : nullptr;
+}
+
+bool ggml_cuda_is_ec_op(const ggml_tensor * dst) {
+    return dst->op == GGML_OP_CUSTOM && ec_params(dst) != nullptr;
+}
+
+static __global__ void ec_request_kernel(const float * __restrict__ x, const int32_t * __restrict__ ids, const int k, const int n_embd,
+                                         const int layer, char * mb, uint32_t * ctl, int32_t * tok) {
+    __shared__ int any;
+    if (threadIdx.x == 0) {
+        int a = 0;
+        for (int j = 0; j < k; ++j) {
+            a |= ids[j] >= 0;
+        }
+        any = a;
+    }
+    __syncthreads();
+    if (!any) {
+        if (threadIdx.x == 0) {
+            tok[0] = 0;
+        }
+        return;
+    }
+    float * mx = (float *) (mb + GGML_EC_MB_X);
+    for (int i = threadIdx.x; i < n_embd; i += blockDim.x) {
+        mx[i] = x[i];
+    }
+    if (threadIdx.x < k) {
+        ((volatile int32_t *) (mb + GGML_EC_MB_IDS))[threadIdx.x] = ids[threadIdx.x];
+    }
+    if (threadIdx.x == 0) {
+        *(volatile int32_t *) (mb + GGML_EC_MB_LAYER) = layer;
+    }
+    __threadfence_system();   // every writer orders its mailbox writes before the publication below
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        const uint32_t s = ctl[0] + 1;
+        ctl[0] = s;
+        __threadfence_system();
+        *(volatile uint32_t *) (mb + GGML_EC_MB_REQ) = s;
+        tok[0] = (int32_t) s;
+    }
+}
+
+template <bool vec4>
+static __global__ void ec_wait_kernel(const int32_t * __restrict__ ids, const float * __restrict__ g, float * __restrict__ dst,
+                                      const int k, const int n_embd, char * mb, const int64_t y_off, const int64_t y_stride,
+                                      const uint32_t * ctl, const long long timeout) {
+    __shared__ int any;
+    if (threadIdx.x == 0) {
+        int a = 0;
+        for (int j = 0; j < k; ++j) {
+            a |= ids[j] >= 0;
+        }
+        any = a;
+        if (a) {
+            const uint32_t want = ctl[0];
+            const long long t0 = clock64();
+            while (*(volatile uint32_t *) (mb + GGML_EC_MB_RESP) != want) {
+                if (clock64() - t0 > timeout) {
+                    *(volatile int32_t *) (mb + GGML_EC_MB_ERR) = 1;
+                    break;
+                }
+            }
+            __threadfence_system();
+        }
+    }
+    __syncthreads();
+    const float * y = (const float *) (mb + y_off);
+    if (vec4) {
+        const int n4 = n_embd / 4;
+        for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < k * n4; t += gridDim.x * blockDim.x) {
+            const int j = t / n4;
+            const int i = t - j * n4;
+            float4 v;
+            if (ids[j] >= 0) {
+                v = __ldcv((const float4 *) (y + j * y_stride) + i);
+            } else if (g) {
+                v = ((const float4 *) (g + (int64_t) j * n_embd))[i];
+            } else {
+                v = make_float4(0.f, 0.f, 0.f, 0.f);
+            }
+            ((float4 *) (dst + (int64_t) j * n_embd))[i] = v;
+        }
+    } else {
+        for (int t = blockIdx.x * blockDim.x + threadIdx.x; t < k * n_embd; t += gridDim.x * blockDim.x) {
+            const int j = t / n_embd;
+            const int i = t - j * n_embd;
+            dst[(int64_t) j * n_embd + i] = ids[j] >= 0 ? __ldcv(y + j * y_stride + i) : (g ? g[(int64_t) j * n_embd + i] : 0.f);
+        }
+    }
+}
+
+// FETCH (see ggml-ec.h): src[0] = GPU ids [k] (slot or -1), src[1] = CPU ids [k] (expert or -1), src[2] = eviction
+// candidates [V] (slots, lowest decayed score first, -1 = end). dst = [2k + 1 + 2*GGML_EC_MAX_K] i32: the GPU ids and
+// CPU ids after fetching, then the plan (n, then (expert, slot) pairs), which is also logged for the host.
+static __global__ void ec_fetch_plan_kernel(const int32_t * __restrict__ gid, const int32_t * __restrict__ cid,
+                                            const int32_t * __restrict__ vic, const int k, const int V,
+                                            const ggml_ec_fetch f, int32_t * __restrict__ out) {
+    if (threadIdx.x != 0) {
+        return;
+    }
+    int32_t * og = out;
+    int32_t * oc = out + k;
+    int32_t * plan = out + 2 * k;
+    int m = 0;
+    for (int j = 0; j < k; ++j) {
+        og[j] = gid[j];
+        oc[j] = cid[j];
+        m += cid[j] >= 0;
+    }
+    const int T = f.table[m < k ? m : k];
+    int n = 0, vi = 0;
+    for (int j = 0; j < k && n < T; ++j) {
+        if (cid[j] < 0) {
+            continue;
+        }
+        int v = -1;
+        while (vi < V && v < 0) {
+            const int c = vic[vi++];
+            if (c < 0) {
+                vi = V;
+                break;
+            }
+            bool busy = false;   // a slot serving a hit of this step cannot be overwritten
+            for (int jj = 0; jj < k; ++jj) {
+                busy |= gid[jj] == c;
+            }
+            if (!busy) {
+                v = c;
+            }
+        }
+        if (v < 0) {
+            break;
+        }
+        plan[1 + 2 * n] = cid[j];
+        plan[2 + 2 * n] = v;
+        og[j] = v;
+        oc[j] = -1;
+        n++;
+    }
+    plan[0] = n;
+    volatile int32_t * lg = f.log;
+    for (int i = 0; i < 2 * n; ++i) {
+        lg[1 + i] = plan[1 + i];
+    }
+    lg[0] = n;
+    __threadfence_system();
+}
+
+static __global__ void ec_fetch_copy_kernel(const int32_t * __restrict__ plan, const ggml_ec_fetch f,
+                                            const int32_t * __restrict__ gid_in, int32_t * __restrict__ gid_out, const int k) {
+    const int n = plan[0];
+    const size_t tid = (size_t) blockIdx.x * blockDim.x + threadIdx.x, nth = (size_t) gridDim.x * blockDim.x;
+    if (gid_out && tid < (size_t) k) {
+        gid_out[tid] = gid_in[tid];   // the GPU path reads its ids from here, so it runs after the copy
+    }
+    for (int i = 0; i < n; ++i) {
+        const int e = plan[1 + 2 * i], v = plan[2 + 2 * i];
+        for (int t = 0; t < f.n_t; ++t) {
+            const size_t st = (size_t) f.stride[t];
+            const char * src = (const char *) f.src[t] + (size_t) e * st;
+            char * dst = (char *) f.slot[t] + (size_t) v * st;
+            if ((((uintptr_t) src | (uintptr_t) dst | st) & 15) == 0) {
+                const int4 * s4 = (const int4 *) src;
+                int4 * d4 = (int4 *) dst;
+                for (size_t q = tid; q < st / 16; q += nth) {
+                    d4[q] = s4[q];
+                }
+            } else {
+                for (size_t q = tid; q < st; q += nth) {
+                    dst[q] = src[q];
+                }
+            }
+        }
+    }
+}
+
+// PREFETCH plan (see ggml-ec.h): src[0] = predicted experts of the target layer [npred] (rank order), src[1..3] = its
+// gpu map, cpu map and eviction candidates [E] (host-filled). dst = [3E + 1 + 2*GGML_EC_MAX_K]: the updated maps and
+// candidates, then the plan (n, (expert, slot) pairs), also logged for the host. q = f.table[0].
+static __global__ void ec_prefetch_plan_kernel(const int32_t * __restrict__ pid, const int npred,
+                                               const int32_t * __restrict__ g, const int32_t * __restrict__ c,
+                                               const int32_t * __restrict__ vic, const int E, const ggml_ec_fetch f,
+                                               int32_t * __restrict__ out) {
+    int32_t * og = out;
+    int32_t * oc = out + E;
+    int32_t * ov = out + 2 * E;
+    int32_t * plan = out + 3 * E;
+    for (int i = threadIdx.x; i < E; i += blockDim.x) {
+        og[i] = g[i];
+        oc[i] = c[i];
+        ov[i] = vic[i];
+    }
+    __syncthreads();
+    if (threadIdx.x != 0) {
+        return;
+    }
+    const int q = f.table[0];
+    int n = 0;
+    for (int i = 0; i < npred && n < q && n < GGML_EC_MAX_K; ++i) {
+        const int e = pid[i];
+        if (e < 0 || e >= E || og[e] >= 0) {
+            continue;   // resident already
+        }
+        int vi = -1, old = -1;
+        for (int j = 0; j < E && ov[j] >= 0 && vi < 0; ++j) {
+            const int s = ov[j];
+            int holder = -1;
+            for (int x = 0; x < E; ++x) {
+                if (og[x] == s) {
+                    holder = x;
+                    break;
+                }
+            }
+            bool predicted = false;   // never evict an expert predicted for this step
+            for (int t = 0; t < npred; ++t) {
+                predicted |= holder >= 0 && pid[t] == holder;
+            }
+            if (!predicted) {
+                vi = j;
+                old = holder;
+            }
+        }
+        if (vi < 0) {
+            break;
+        }
+        const int s = ov[vi];
+        for (int j = vi; j < E - 1; ++j) {   // the candidate is used up
+            ov[j] = ov[j + 1];
+        }
+        ov[E - 1] = -1;
+        if (old >= 0) {
+            og[old] = -1;
+            oc[old] = old;
+        }
+        og[e] = s;
+        oc[e] = -1;
+        plan[1 + 2 * n] = e;
+        plan[2 + 2 * n] = s;
+        n++;
+    }
+    plan[0] = n;
+    volatile int32_t * lg = f.log;
+    for (int i = 0; i < 2 * n; ++i) {
+        lg[1 + i] = plan[1 + i];
+    }
+    lg[0] = n;
+    __threadfence_system();
+}
+
+// the side stream of the prefetch copies and, per target layer, the fork / join events (created on first use)
+struct ec_side_t {
+    cudaStream_t stream = nullptr;
+    std::vector<cudaEvent_t> fork, join;
+};
+static ec_side_t ec_side[GGML_CUDA_MAX_DEVICES];
+
+static cudaEvent_t ec_event(std::vector<cudaEvent_t> & v, int i) {
+    if ((int) v.size() <= i) {
+        v.resize(i + 1, nullptr);
+    }
+    if (!v[i]) {
+        CUDA_CHECK(cudaEventCreateWithFlags(&v[i], cudaEventDisableTiming));
+    }
+    return v[i];
+}
+
+void ggml_cuda_op_ec(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_ec_op * p = ec_params(dst);
+    GGML_ASSERT(p != nullptr);
+    cudaStream_t stream = ctx.stream();
+    if (p->mode == GGML_EC_PREFETCH) {
+        const ggml_tensor * pid = dst->src[0];
+        GGML_ASSERT(p->fetch != nullptr && pid->type == GGML_TYPE_I32 && ggml_is_contiguous(pid));
+        const int E = p->fetch->n_expert;
+        for (int i = 1; i <= 3; ++i) {
+            GGML_ASSERT(dst->src[i]->type == GGML_TYPE_I32 && ggml_is_contiguous(dst->src[i]) && ggml_nelements(dst->src[i]) >= E);
+        }
+        GGML_ASSERT(ggml_nelements(dst) >= 3 * E + 1 + 2 * GGML_EC_MAX_K);
+        ec_prefetch_plan_kernel<<<1, 128, 0, stream>>>((const int32_t *) pid->data, (int) ggml_nelements(pid),
+                (const int32_t *) dst->src[1]->data, (const int32_t *) dst->src[2]->data, (const int32_t *) dst->src[3]->data,
+                E, *p->fetch, (int32_t *) dst->data);
+    } else if (p->mode == GGML_EC_PREFETCH_COPY) {
+        const ggml_tensor * plan = dst->src[0];
+        GGML_ASSERT(p->fetch != nullptr && plan->type == GGML_TYPE_I32);
+        ec_side_t & sd = ec_side[ctx.device];
+        if (!sd.stream) {
+            CUDA_CHECK(cudaStreamCreateWithFlags(&sd.stream, cudaStreamNonBlocking));
+        }
+        cudaEvent_t f = ec_event(sd.fork, p->layer), j = ec_event(sd.join, p->layer);
+        CUDA_CHECK(cudaEventRecord(f, stream));
+        CUDA_CHECK(cudaStreamWaitEvent(sd.stream, f, 0));
+        ec_fetch_copy_kernel<<<p->fetch->blocks, 256, 0, sd.stream>>>((const int32_t *) plan->data + 3 * p->fetch->n_expert,
+                *p->fetch, nullptr, nullptr, 0);
+        CUDA_CHECK(cudaEventRecord(j, sd.stream));
+    } else if (p->mode == GGML_EC_PREFETCH_JOIN) {
+        const ggml_tensor * gid = dst->src[0];   // src[1] = the plan (kept alive until here), src[2] = the copy op (order)
+        GGML_ASSERT(gid->type == GGML_TYPE_I32 && dst->type == GGML_TYPE_I32 && ggml_nelements(dst) == ggml_nelements(gid));
+        ec_side_t & sd = ec_side[ctx.device];
+        if (p->layer < (int) sd.join.size() && sd.join[p->layer]) {
+            CUDA_CHECK(cudaStreamWaitEvent(stream, sd.join[p->layer], 0));
+        }
+        CUDA_CHECK(cudaMemcpyAsync(dst->data, gid->data, ggml_nbytes(gid), cudaMemcpyDeviceToDevice, stream));
+    } else if (p->mode == GGML_EC_FETCH) {
+        const ggml_tensor * gid = dst->src[0];
+        const ggml_tensor * cid = dst->src[1];
+        const ggml_tensor * vic = dst->src[2];
+        GGML_ASSERT(p->fetch != nullptr);
+        GGML_ASSERT(gid->type == GGML_TYPE_I32 && cid->type == GGML_TYPE_I32 && vic->type == GGML_TYPE_I32);
+        GGML_ASSERT(ggml_is_contiguous(gid) && ggml_is_contiguous(cid) && ggml_is_contiguous(vic));
+        const int k = (int) ggml_nelements(gid);
+        GGML_ASSERT(k == ggml_nelements(cid) && k <= GGML_EC_MAX_K && ggml_nelements(dst) >= 2 * k + 1 + 2 * k);
+        ec_fetch_plan_kernel<<<1, 32, 0, stream>>>((const int32_t *) gid->data, (const int32_t *) cid->data,
+                (const int32_t *) vic->data, k, (int) ggml_nelements(vic), *p->fetch, (int32_t *) dst->data);
+        if (p->fetch->copy_in_plan) {   // one-op form (no overlap): copy right away
+            ec_fetch_copy_kernel<<<p->fetch->blocks, 256, 0, stream>>>((const int32_t *) dst->data + 2 * k, *p->fetch, nullptr, nullptr, k);
+        }
+    } else if (p->mode == GGML_EC_FETCH_COPY) {
+        const ggml_tensor * plan = dst->src[0];   // the FETCH op's output: [gid2 | cid2 | plan]
+        GGML_ASSERT(p->fetch != nullptr && plan->type == GGML_TYPE_I32 && dst->type == GGML_TYPE_I32);
+        const int k = (int) ggml_nelements(dst);
+        ec_fetch_copy_kernel<<<p->fetch->blocks, 256, 0, stream>>>((const int32_t *) plan->data + 2 * k, *p->fetch,
+                (const int32_t *) plan->data, (int32_t *) dst->data, k);
+    } else if (p->mode == GGML_EC_REQUEST) {
+        const ggml_tensor * x   = dst->src[0];
+        const ggml_tensor * ids = dst->src[1];
+        GGML_ASSERT(x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) && ggml_nrows(x) == 1);
+        GGML_ASSERT(ids->type == GGML_TYPE_I32 && ggml_is_contiguous(ids) && ggml_nelements(ids) <= GGML_EC_MAX_K);
+        const int k = (int) ggml_nelements(ids);
+        ec_request_kernel<<<1, 256, 0, stream>>>((const float *) x->data, (const int32_t *) ids->data, k, (int) x->ne[0],
+                p->layer, (char *) p->mailbox, p->ctl, (int32_t *) dst->data);
+    } else {
+        const ggml_tensor * ids = dst->src[0];
+        const ggml_tensor * g   = dst->src[2];
+        GGML_ASSERT(ids->type == GGML_TYPE_I32 && ggml_is_contiguous(ids));
+        GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+        const int k = (int) ggml_nelements(ids);
+        const int n_embd = (int) dst->ne[0];
+        GGML_ASSERT(dst->ne[1] == k && ggml_nrows(dst) == k);
+        if (g) {
+            GGML_ASSERT(g->type == GGML_TYPE_F32 && ggml_is_contiguous(g) && ggml_are_same_shape(g, dst));
+        }
+        const bool v4 = n_embd % 4 == 0 && p->y_stride % 4 == 0 && p->y_off % 16 == 0;
+        const int n_blocks = 4;
+        if (v4) {
+            ec_wait_kernel<true><<<n_blocks, 256, 0, stream>>>((const int32_t *) ids->data, g ? (const float *) g->data : nullptr,
+                    (float *) dst->data, k, n_embd, (char *) p->mailbox, p->y_off, p->y_stride, p->ctl, p->timeout_cycles);
+        } else {
+            ec_wait_kernel<false><<<n_blocks, 256, 0, stream>>>((const int32_t *) ids->data, g ? (const float *) g->data : nullptr,
+                    (float *) dst->data, k, n_embd, (char *) p->mailbox, p->y_off, p->y_stride, p->ctl, p->timeout_cycles);
+        }
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
