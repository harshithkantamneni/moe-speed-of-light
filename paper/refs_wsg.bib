% Bypass optimality. CHOPT, full text read: https://geraldleizhang.com/publications/CHOPT_Sigmetrics20.pdf ;
% Crossref 10.1145/3379472.
% Sec. 3.1 defines the model: on a miss, either load the block into L1 or "serve x_t directly from L2
% without loading into L1" (cache bypass).
% Sec. 3.4: its two correctness lemmas "establish the optimality of the cache-bypass policy OPT_b that
% was investigated without proof by Michaud [TACO 2016]".
% Sec. 5 defines Belady-AD, which "bypasses any object whose next access is farther in the future than
% all other objects currently resident in the cache".
% CHOPT does not itself write out OPT_b as farthest-in-future with bypass; that definition is in Michaud,
% whose full text was blocked (HTTP 403 at ACM and HAL). For an explicit statement that the bypass rule
% maximizes the hit rate, co-cite hasslinger2018 (Sec. II).
@article{bypassopt,
  title   = {Optimal Data Placement for Heterogeneous Cache, Memory, and Storage Systems},
  author  = {Zhang, Lei and Karimi, Reza and Ahmad, Irfan and Vigfusson, Ymir},
  journal = {Proceedings of the ACM on Measurement and Analysis of Computing Systems (POMACS)},
  volume  = {4},
  number  = {1},
  pages   = {6:1--6:27},
  doi     = {10.1145/3379472},
  year    = {2020}
}
